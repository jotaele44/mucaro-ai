{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/video_cli_parity.schema.json",
  "title": "Mucaro VIDEO_CLI_PARITY_V1 denominator",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","denominator_id","frozen_date","baseline_main_sha","source_manifest","scope","closure_rule","capabilities"],
  "properties": {
    "schema": {"const":"mucaro-video-cli-parity-denominator/1.0"},
    "denominator_id": {"const":"VIDEO_CLI_PARITY_V1"},
    "frozen_date": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "baseline_main_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_manifest": {
      "type":"object",
      "additionalProperties": false,
      "required":["kind","filename","sha256","duration_seconds","video_codec","width","height","frame_rate"],
      "properties":{
        "kind":{"const":"USER_SUPPLIED_VIDEO"},
        "filename":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "duration_seconds":{"type":"number","exclusiveMinimum":0},
        "video_codec":{"type":"string","minLength":1},
        "width":{"type":"integer","minimum":1},
        "height":{"type":"integer","minimum":1},
        "frame_rate":{"type":"string","minLength":1}
      }
    },
    "scope":{"type":"string","minLength":1},
    "closure_rule":{"type":"string","minLength":1},
    "capabilities":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["id","capability","required","flagpole_domains","observed_behavior"],
        "properties":{
          "id":{"type":"string","pattern":"^VCP-[0-9]{3}$"},
          "capability":{"type":"string","pattern":"^[a-z0-9_]+$"},
          "required":{"const":true},
          "flagpole_domains":{
            "type":"array",
            "minItems":1,
            "uniqueItems":true,
            "items":{"type":"string","pattern":"^V(?:0[0-9]|1[0-9]|2[0-3])$"}
          },
          "observed_behavior":{"type":"string","minLength":1}
        }
      }
    }
  }
}
