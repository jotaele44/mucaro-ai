{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mucaro.local/schemas/next_vector_proposal.schema.json",
  "title":"Mucaro Next Vector Proposal 1.0",
  "description":"A model-authored next vector parsed from a finished answer. Data only: it never authorizes a run, a tool call or a gate.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","vector_id","vector_sha256","status","authority","source","anchor","step_count","sections","claimed_gates","text","review","suggestion"],
  "properties":{
    "schema_version":{"const":"mucaro-next-vector-proposal/1.0"},
    "vector_id":{"type":"string","pattern":"^nvec_[0-9a-f]{16}$"},
    "vector_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"const":"PROPOSED"},
    "authority":{"const":"NONE"},
    "source":{
      "type":"object",
      "additionalProperties":false,
      "required":["kind","work_run_id","answer_run_id","model_provider","model_name","fenced","network_tools"],
      "properties":{
        "kind":{"const":"MODEL_OUTPUT"},
        "work_run_id":{"type":"string","minLength":1},
        "answer_run_id":{"type":["string","null"]},
        "model_provider":{"type":["string","null"]},
        "model_name":{"type":["string","null"]},
        "fenced":{"type":"boolean"},
        "network_tools":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "anchor":{"type":"string","minLength":1,"maxLength":240},
    "step_count":{"type":"integer","minimum":0,"maximum":32},
    "sections":{
      "type":"array",
      "minItems":1,
      "maxItems":8,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["key","title","anchor","steps","rows"],
        "properties":{
          "key":{"type":"string","pattern":"^[A-Z0-9_]{1,40}$"},
          "title":{"type":"string","minLength":1,"maxLength":40},
          "anchor":{"type":["string","null"],"maxLength":240},
          "steps":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":240}},
          "rows":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":240}}
        }
      }
    },
    "claimed_gates":{
      "type":"array",
      "maxItems":32,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["gate","claimed_state","state_class","basis","verified"],
        "properties":{
          "gate":{"type":"string","minLength":1,"maxLength":240},
          "claimed_state":{"type":"string","minLength":1,"maxLength":80},
          "state_class":{"enum":["PASS","OPEN","WITHHELD","FAIL","OTHER"]},
          "basis":{"const":"MODEL_CLAIM"},
          "verified":{"const":false}
        }
      }
    },
    "text":{"type":"string","minLength":1,"maxLength":4000},
    "review":{
      "type":"object",
      "additionalProperties":false,
      "required":["preselect","reasons","signals"],
      "properties":{
        "preselect":{"type":"boolean"},
        "reasons":{"type":"array","uniqueItems":true,"items":{"enum":["INSTRUCTION_LIKE_TEXT_IN_VECTOR","INSTRUCTION_LIKE_TEXT_IN_SOURCES","ANSWER_TRUNCATED"]}},
        "signals":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "suggestion":{
      "type":"object",
      "additionalProperties":false,
      "required":["id","label","prompt"],
      "properties":{
        "id":{"const":"proposed"},
        "label":{"type":"string","minLength":1,"maxLength":120},
        "prompt":{"type":"string","minLength":1,"maxLength":6000}
      }
    }
  }
}
