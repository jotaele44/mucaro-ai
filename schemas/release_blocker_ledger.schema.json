{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/release_blocker_ledger.schema.json",
  "title": "Mucaro Release Blocker Ledger 1.0",
  "description": "KERNEL-020 blocker records. Blockers are never deleted; they move to RESOLVED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blockers"],
  "properties": {
    "schema_version": {"const": "mucaro-release-blocker-ledger/1.0"},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker_id", "blocked_node", "reason", "external_dependency", "evidence", "what_would_unblock", "dependent_nodes", "independent_work_remaining", "status"],
        "properties": {
          "blocker_id": {"type": "string", "pattern": "^BLK-[A-Z0-9]+-[0-9]{3}$"},
          "blocked_node": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "external_dependency": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "what_would_unblock": {"type": "string", "minLength": 1},
          "dependent_nodes": {"type": "array", "items": {"type": "string"}},
          "independent_work_remaining": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["ACTIVE", "RESOLVED"]},
          "resolution": {"type": ["string", "null"]}
        }
      }
    }
  }
}
