{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/goal.schema.json",
  "title": "Mucaro durable operator goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goal_id", "objective", "active_vector", "status", "assumptions", "gaps", "variables", "metadata", "is_current", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "mucaro-goal/1.0"},
    "goal_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "active_vector": {"type": "string", "minLength": 1, "maxLength": 240},
    "status": {"enum": ["ACTIVE", "PAUSED", "COMPLETE", "BLOCKED", "CANCELLED"]},
    "assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "gaps": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "variables": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "metadata": {"type": "object"},
    "is_current": {"type": "boolean"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
