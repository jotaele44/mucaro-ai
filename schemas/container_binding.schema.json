{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/container_binding.schema.json",
  "title": "Mucaro Container Binding 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "image", "binding_sha256"],
  "properties": {
    "schema_version": {"const": "mucaro-container-binding/1.0"},
    "skill_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
