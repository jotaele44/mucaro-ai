{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/agent_task_dag.schema.json",
  "title": "Mucaro Agent Task DAG 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_sha256",
    "created_at",
    "task_count",
    "edge_count",
    "tasks",
    "topological_order",
    "ready_task_ids",
    "state_counts",
    "invariants"
  ],
  "properties": {
    "schema_version": {"const": "mucaro-agent-task-dag/1.0"},
    "definition_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "created_at": {"type":"string","minLength":1},
    "task_count": {"type":"integer","minimum":1},
    "edge_count": {"type":"integer","minimum":0},
    "tasks": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required": [
          "id","title","description","depends_on","state","attempt_count",
          "evidence","artifacts","blocked_reason","created_at","started_at","completed_at","metadata"
        ],
        "properties": {
          "id":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},
          "title":{"type":"string","minLength":1,"maxLength":512},
          "description":{"type":"string","maxLength":4000},
          "depends_on":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"}},
          "state":{"enum":["PENDING","READY","RUNNING","AWAITING_APPROVAL","AWAITING_INPUT","BLOCKED","FAILED","PASSED","SKIPPED","SUPERSEDED"]},
          "attempt_count":{"type":"integer","minimum":0},
          "evidence":{"type":"array","items":{"type":"object"}},
          "artifacts":{"type":"array","items":{"type":"object"}},
          "blocked_reason":{"type":["string","null"]},
          "created_at":{"type":"string","minLength":1},
          "started_at":{"type":["string","null"]},
          "completed_at":{"type":["string","null"]},
          "metadata":{"type":"object"}
        }
      }
    },
    "topological_order":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "ready_task_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "state_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "invariants":{
      "type":"object",
      "additionalProperties":false,
      "required":["unique_task_ids","dependencies_exist","acyclic","row_accounting_closed","ready_dependencies_satisfied"],
      "properties":{
        "unique_task_ids":{"const":true},
        "dependencies_exist":{"const":true},
        "acyclic":{"const":true},
        "row_accounting_closed":{"const":true},
        "ready_dependencies_satisfied":{"const":true}
      }
    }
  }
}
