{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/memory_item.schema.json",
  "title": "Mucaro Memory Item 1.0",
  "description": "MEMORY contract: one durable, user-controlled memory row. Memory is context only and never an authorization channel (INV-021).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "kind",
    "content",
    "enabled",
    "source",
    "scope",
    "scope_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "memory_id": {
      "type": "string",
      "pattern": "^mem_[a-f0-9]+$"
    },
    "kind": {
      "enum": [
        "preference",
        "profile",
        "instruction",
        "fact"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "enabled": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "global",
        "workspace",
        "conversation"
      ]
    },
    "scope_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "global"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "scope_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "enum": [
              "workspace",
              "conversation"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  ]
}
