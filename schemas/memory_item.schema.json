{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/memory_item.schema.json",
  "title": "Mucaro Memory Item 1.0",
  "description": "MEMORY contract: one durable, user-controlled memory row. Memory is context only and never an authorization channel (INV-021).",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_id", "kind", "content", "enabled", "source", "created_at", "updated_at"],
  "properties": {
    "memory_id": {"type": "string", "pattern": "^mem_[a-f0-9]+$"},
    "kind": {"enum": ["preference", "profile", "instruction", "fact"]},
    "content": {"type": "string", "minLength": 1, "maxLength": 800},
    "enabled": {"type": "boolean"},
    "source": {"type": "string", "minLength": 1},
    "scope": {"enum": ["global", "workspace", "conversation"]},
    "scope_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"required": ["scope"], "properties": {"scope": {"const": "workspace"}}}, "then": {"required": ["scope_id"]}},
    {"if": {"required": ["scope"], "properties": {"scope": {"const": "conversation"}}}, "then": {"required": ["scope_id"]}},
    {"if": {"required": ["scope"], "properties": {"scope": {"const": "global"}}}, "then": {"properties": {"scope_id": {"type": "null"}}}}
  ]
}
