{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mucaro.local/schemas/permission_lease.schema.json",
  "title":"Mucaro Run Permission Lease 1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","lease_id","run_id","scope_type","tool_names","tool_prefixes","workspace_root","arguments_sha256","allow_mutating","allow_network","granted_by","created_at","expires_at","max_uses","used_call_ids","state","revoked_at","revoked_by","grant_sha256"],
  "properties":{
    "schema_version":{"const":"mucaro-permission-lease/1.0"},
    "lease_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "scope_type":{"enum":["RUN_READ_ONLY","EXACT_TOOLS","TOOL_PREFIXES"]},
    "tool_names":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "tool_prefixes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "workspace_root":{"type":["string","null"]},
    "arguments_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "allow_mutating":{"type":"boolean"},
    "allow_network":{"type":"boolean"},
    "granted_by":{"type":"string","minLength":1},
    "created_at":{"type":"string","minLength":1},
    "expires_at":{"type":["string","null"]},
    "max_uses":{"type":"integer","minimum":1,"maximum":1000},
    "used_call_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "state":{"enum":["ACTIVE","REVOKED"]},
    "revoked_at":{"type":["string","null"]},
    "revoked_by":{"type":["string","null"]},
    "grant_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
