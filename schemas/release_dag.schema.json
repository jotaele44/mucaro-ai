{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/release_dag.schema.json",
  "title": "Mucaro Release Dependency DAG 1.0",
  "description": "KERNEL-006 dependency graph of release work nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {"const": "mucaro-release-dag/1.0"},
    "updated_utc": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "title", "requirement_ids", "dependencies", "state", "risk", "user_value", "downstream_unlock_value", "expected_rework_cost", "evidence_required", "blocker"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^N[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "state": {"enum": ["READY", "RUNNING", "PASS", "FAIL", "OPEN", "BLOCKED", "PROVISIONAL", "SUPERSEDED"]},
          "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "user_value": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "downstream_unlock_value": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "expected_rework_cost": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "evidence_required": {"type": "array", "items": {"type": "string"}},
          "blocker": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
