{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mucaro.local/schemas/autopilot_state.schema.json",
  "title":"Mucaro Autopilot State 1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","status","authorization_state","authorized_by","authorized_at","started_at","updated_at","budgets","counters","fingerprint_history","no_progress_streak","stop_reason","last_task_id"],
  "properties":{
    "schema_version":{"const":"mucaro-autopilot/1.0"},
    "status":{"enum":["PLANNED","AUTHORIZED","RUNNING","WAITING_APPROVAL","WAITING_INPUT","PAUSED","STOPPED","COMPLETED"]},
    "authorization_state":{"enum":["PENDING","AUTHORIZED"]},
    "authorized_by":{"type":["string","null"]},
    "authorized_at":{"type":["string","null"]},
    "started_at":{"type":["string","null"]},
    "updated_at":{"type":"string","minLength":1},
    "budgets":{
      "type":"object","additionalProperties":false,
      "required":["max_steps","max_tool_calls","max_mutations","max_remote_calls","max_replans","max_wall_seconds","max_model_tokens","max_cost_microunits","max_no_progress","max_fingerprint_occurrences"],
      "properties":{
        "max_steps":{"type":["integer","null"],"minimum":1},
        "max_tool_calls":{"type":["integer","null"],"minimum":1},
        "max_mutations":{"type":["integer","null"],"minimum":0},
        "max_remote_calls":{"type":["integer","null"],"minimum":0},
        "max_replans":{"type":["integer","null"],"minimum":0},
        "max_wall_seconds":{"type":["integer","null"],"minimum":1},
        "max_model_tokens":{"type":["integer","null"],"minimum":1},
        "max_cost_microunits":{"type":["integer","null"],"minimum":1},
        "max_no_progress":{"type":"integer","minimum":1},
        "max_fingerprint_occurrences":{"type":"integer","minimum":2}
      }
    },
    "counters":{
      "type":"object","additionalProperties":false,
      "required":["steps","tool_calls","mutations","remote_calls","replans","model_tokens","cost_microunits"],
      "properties":{
        "steps":{"type":"integer","minimum":0},
        "tool_calls":{"type":"integer","minimum":0},
        "mutations":{"type":"integer","minimum":0},
        "remote_calls":{"type":"integer","minimum":0},
        "replans":{"type":"integer","minimum":0},
        "model_tokens":{"type":["integer","null"],"minimum":0},
        "cost_microunits":{"type":["integer","null"],"minimum":0}
      }
    },
    "fingerprint_history":{"type":"array","maxItems":32,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "no_progress_streak":{"type":"integer","minimum":0},
    "stop_reason":{"type":["string","null"]},
    "last_task_id":{"type":["string","null"]}
  }
}
