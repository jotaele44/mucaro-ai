{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/autopilot_plan_proposal.schema.json",
  "title": "Mucaro Autopilot Plan Proposal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "objective",
    "rationale",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "mucaro-autopilot-plan-proposal/1.0"
    },
    "kind": {
      "enum": [
        "INITIAL",
        "REPLAN"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "rationale": {
      "type": "string",
      "maxLength": 4000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "depends_on",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          },
          "action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool_name",
                  "arguments"
                ],
                "properties": {
                  "tool_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "arguments": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
