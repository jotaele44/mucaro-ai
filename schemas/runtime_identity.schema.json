{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/runtime_identity.schema.json",
  "title": "Mucaro Runtime Identity 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "skill_id",
    "skill_version",
    "skill_digest",
    "git_head",
    "python_version",
    "python_implementation",
    "python_executable",
    "platform",
    "machine",
    "package_versions",
    "runtime_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "mucaro-runtime-identity/1.0"},
    "runtime": {"enum": ["IN_PROCESS", "LOCAL_WORKER", "CONTAINER", "SERVICE", "FEDERATION_WORKER"]},
    "skill_id": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "skill_digest": {"type": "string", "minLength": 1},
    "git_head": {"type": ["string", "null"]},
    "python_version": {"type": "string", "minLength": 1},
    "python_implementation": {"type": "string", "minLength": 1},
    "python_executable": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "machine": {"type": "string"},
    "package_versions": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "runtime_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
