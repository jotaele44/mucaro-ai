{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mucaro.local/schemas/context_usage.schema.json",
  "title":"Mucaro Context Usage Status 1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","created_at","conversation_id","model","context_state","metrics","warnings"],
  "$defs":{
    "metric":{
      "type":"object",
      "additionalProperties":false,
      "required":["value","classification","unit","source","basis"],
      "properties":{
        "value":{"type":["integer","number","null"],"minimum":0},
        "classification":{"enum":["MEASURED","PROVIDER_REPORTED","COMPUTED","ESTIMATED","UNKNOWN"]},
        "unit":{"type":"string","minLength":1},
        "source":{"type":"string","minLength":1},
        "basis":{"type":"array","items":{"type":"string","minLength":1}}
      }
    }
  },
  "properties":{
    "schema_version":{"const":"mucaro-context-usage/1.0"},
    "created_at":{"type":"string","minLength":1},
    "conversation_id":{"type":["string","null"]},
    "model":{
      "type":"object",
      "additionalProperties":false,
      "required":["provider","name","run_mode","locality","supports_streaming"],
      "properties":{
        "provider":{"type":["string","null"]},
        "name":{"type":["string","null"]},
        "run_mode":{"type":["string","null"]},
        "locality":{"type":["string","null"]},
        "supports_streaming":{"type":["boolean","null"]}
      }
    },
    "context_state":{
      "type":"object",
      "additionalProperties":false,
      "required":["context_state_id","raw_turn_count","historical_turn_count","recent_turn_count","represented_historical_turns","total_historical_turns","coverage_ratio","raw_history_mutated"],
      "properties":{
        "context_state_id":{"type":"string","minLength":1},
        "raw_turn_count":{"type":"integer","minimum":0},
        "historical_turn_count":{"type":"integer","minimum":0},
        "recent_turn_count":{"type":"integer","minimum":0},
        "represented_historical_turns":{"type":"integer","minimum":0},
        "total_historical_turns":{"type":"integer","minimum":0},
        "coverage_ratio":{"type":"number","minimum":0,"maximum":1},
        "raw_history_mutated":{"const":false}
      }
    },
    "metrics":{
      "type":"object",
      "additionalProperties":false,
      "required":["raw_context_chars","raw_context_bytes","model_context_chars","model_context_bytes","compacted_summary_chars","recent_context_chars","context_limit_tokens","input_tokens","cache_creation_input_tokens","cache_read_input_tokens","effective_input_tokens","output_tokens","total_tokens","context_consumed_tokens","remaining_context_tokens","context_utilization_ratio","answer_chars","answer_bytes","cost_microunits"],
      "properties":{
        "raw_context_chars":{"$ref":"#/$defs/metric"},
        "raw_context_bytes":{"$ref":"#/$defs/metric"},
        "model_context_chars":{"$ref":"#/$defs/metric"},
        "model_context_bytes":{"$ref":"#/$defs/metric"},
        "compacted_summary_chars":{"$ref":"#/$defs/metric"},
        "recent_context_chars":{"$ref":"#/$defs/metric"},
        "context_limit_tokens":{"$ref":"#/$defs/metric"},
        "input_tokens":{"$ref":"#/$defs/metric"},
        "cache_creation_input_tokens":{"$ref":"#/$defs/metric"},
        "cache_read_input_tokens":{"$ref":"#/$defs/metric"},
        "effective_input_tokens":{"$ref":"#/$defs/metric"},
        "output_tokens":{"$ref":"#/$defs/metric"},
        "total_tokens":{"$ref":"#/$defs/metric"},
        "context_consumed_tokens":{"$ref":"#/$defs/metric"},
        "remaining_context_tokens":{"$ref":"#/$defs/metric"},
        "context_utilization_ratio":{"$ref":"#/$defs/metric"},
        "answer_chars":{"$ref":"#/$defs/metric"},
        "answer_bytes":{"$ref":"#/$defs/metric"},
        "cost_microunits":{"$ref":"#/$defs/metric"}
      }
    },
    "warnings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}