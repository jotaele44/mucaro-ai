{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro.local/schemas/release_scope_manifest.schema.json",
  "title": "Mucaro Release Scope Manifest 1.0",
  "description": "KERNEL-002 RELEASE_SCOPE_MANIFEST: every bound requirement classified exactly once.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "release_class", "bound_specifications", "missing_specifications", "requirements"],
  "properties": {
    "schema_version": {"const": "mucaro-release-scope-manifest/1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string"},
    "release_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform", "architectures", "minimum_os", "distribution"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "architectures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "minimum_os": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "bound_specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id", "path", "sha256", "id_pattern", "id_prefix", "binding"],
        "properties": {
          "spec_id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": ["string", "null"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "id_pattern": {"type": "string", "minLength": 1},
          "id_prefix": {"type": "string"},
          "extra_named_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirement_id", "heading"],
              "properties": {"requirement_id": {"type": "string"}, "heading": {"type": "string"}}
            }
          },
          "binding": {"enum": ["BOUND", "OPEN"]},
          "provenance": {"type": "string"}
        }
      }
    },
    "missing_specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "binding", "blocker_id", "search_record"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "binding": {"const": "OPEN"},
          "blocker_id": {"type": "string", "minLength": 1},
          "search_record": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "title", "source", "requirement_class", "scope_state", "verification_method"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "requirement_class": {"enum": ["GOAL", "PROCESS", "INVARIANT", "PRODUCT", "EVIDENCE_GATE", "INTERACTION", "DEFECT"]},
          "scope_state": {"enum": ["IN_SCOPE", "NOT_APPLICABLE", "EXTERNALLY_BLOCKED"]},
          "verification_method": {"enum": ["AUTOMATED_TEST", "RENDERED_EVIDENCE", "BENCHMARK", "PACKAGING_EVIDENCE", "LEDGER_VALIDATOR", "PROCESS_AUDIT", "EXTERNAL_RECEIPT", "INSPECTION"]},
          "justification": {"type": "string"},
          "justification_evidence": {"type": "array", "items": {"type": "string"}},
          "blocker_id": {"type": ["string", "null"]},
          "crosswalk": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
