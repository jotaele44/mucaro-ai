{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mucaro-ai.local/schemas/answer_trace.schema.json",
  "title": "AnswerTrace",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "query", "model_provider", "model_name", "prompt_template_id", "retrieved_chunk_ids", "cited_chunk_ids", "source_ids", "answer", "confidence", "validation_flags", "created_at"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[a-f0-9]+$"},
    "query": {"type": "string", "minLength": 1},
    "model_provider": {"type": "string", "enum": ["mock", "anthropic"]},
    "model_name": {"type": "string", "minLength": 1},
    "prompt_template_id": {"type": "string", "minLength": 1},
    "retrieval_strategy": {"type": "string", "minLength": 1},
    "retrieved_chunk_ids": {"type": "array", "items": {"type": "string"}},
    "cited_chunk_ids": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "answer": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "validation_flags": {"type": "array", "items": {"type": "string"}},
    "citation_status": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
