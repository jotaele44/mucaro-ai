#!/bin/bash
# Launcher inside Mucaro AI.app (macOS). Double-clicking the app runs this script.
#
# It opens the setup progress page in the default browser, then starts the double-click setup
# (scripts/one_click.sh --ui) in the background and exits right away. The progress page follows
# setup and switches to Mucaro AI when it is ready; the app keeps running in the background until
# the "Quit Mucaro AI" button is used. Because this launcher exits at once, every double-click
# starts a fresh launcher: if Mucaro AI is already running, the page goes straight to it.
#
# Rules (same as scripts/one_click.sh): bash 3.2, ASCII only, never runs python/git/node/npm from PATH.
set -uo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
ROOT="$(dirname "${APP_DIR}")"

alert() {
  # Only used when the app cannot start at all; there is no page to show the problem on.
  /usr/bin/osascript -e "display alert \"Mucaro AI cannot start\" message \"$1\" as critical" >/dev/null 2>&1 || true
}

case "${APP_DIR}" in
  */AppTranslocation/*)
    # macOS runs downloaded (quarantined) apps from a temporary read-only copy, away from the project files.
    alert "macOS opened a temporary copy of Mucaro AI because the folder was downloaded as a ZIP. Move the whole mucaro-ai folder to another folder with Finder (for example your Documents or Developer folder), then open Mucaro AI again. Cloning with git avoids this."
    exit 1
    ;;
esac

if [ ! -f "${ROOT}/scripts/one_click.sh" ]; then
  alert "Keep Mucaro AI.app inside the mucaro-ai folder. It could not find the project files next to it."
  exit 1
fi
cd "${ROOT}" || exit 1

RUNTIME="${ROOT}/.mucaro-runtime"
PAGE="${RUNTIME}/ui/progress.html"
if ! mkdir -p "${RUNTIME}/logs" "${RUNTIME}/ui" 2>/dev/null; then
  alert "The mucaro-ai folder is read-only. Move it somewhere writable (for example your Documents or Developer folder) and open Mucaro AI again."
  exit 1
fi
RUN_LOG="${RUNTIME}/logs/run-$(date +%Y%m%d-%H%M%S).log"
export MUCARO_RUN_LOG="${RUN_LOG}"

# shellcheck source=scripts/progress_page.sh
. "${ROOT}/scripts/progress_page.sh"
progress_page_write "${PAGE}" running 0 "Starting Mucaro AI" "Checking what needs to be set up..." "${RUN_LOG}"

open_page=1
wait_for_worker=0
for arg in ${1+"$@"}; do
  case "${arg}" in
    --no-browser) open_page=0 ;;
    --smoke-test) wait_for_worker=1 ;;
  esac
done
if [ "${open_page}" = "1" ]; then
  /usr/bin/open "${PAGE}" || true
fi

run_worker() {
  /bin/bash "${ROOT}/scripts/one_click.sh" --ui ${1+"$@"} >>"${RUN_LOG}" 2>&1
  rc=$?
  # Setup and the launcher leave the page ready, stopped, or in error; "running" here means a crash.
  if grep -q 'class="state-running"' "${PAGE}" 2>/dev/null; then
    progress_page_write "${PAGE}" error 0 "Mucaro AI stopped unexpectedly" "Setup ended with code ${rc} before the app was ready." "${RUN_LOG}"
  fi
  return "${rc}"
}

if [ "${wait_for_worker}" = "1" ]; then
  # Automated checks (CI) wait for the result; a double-click never passes --smoke-test.
  run_worker ${1+"$@"}
  exit $?
fi

# Detach: own process group (job control) so nothing tied to this short-lived launcher stops the app.
set -m
( trap '' HUP; run_worker ${1+"$@"} ) </dev/null >/dev/null 2>&1 &
exit 0
