# Optional. Leave unset for deterministic mock mode.
ANTHROPIC_API_KEY=
MUCARO_AI_LIVE_MODE=0
# Set to 1 to fail closed on every Mucaro external-network capability. Loopback/local services remain available.
MUCARO_AI_OFFLINE=0
MUCARO_AI_MODEL=claude-sonnet-5
# low answers fastest; medium, high, xhigh or max think longer first. See README.
MUCARO_AI_MODEL_EFFORT=low
MUCARO_AI_DEPLOYMENT_PROFILE=local
MUCARO_AI_DISTRIBUTION_CHANNEL=local
MUCARO_AI_DATA_DIR=
MUCARO_AI_ALLOW_PUBLIC_BIND=0
MUCARO_AI_OPERATOR_TOKEN=
# 1 lets a phone on the same Wi-Fi or VPN use Mucaro; it needs an access token. See docs/PHONE_ACCESS.md.
MUCARO_AI_PHONE_ACCESS=0
