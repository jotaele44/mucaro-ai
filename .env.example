# Optional. Leave unset for deterministic mock mode.
ANTHROPIC_API_KEY=
MUCARO_AI_LIVE_MODE=0
MUCARO_AI_MODEL=claude-sonnet-5
# low answers fastest; medium, high, xhigh or max think longer first. See README.
MUCARO_AI_MODEL_EFFORT=low
# Open models through an OpenAI-compatible server. Both can also be set in the app when starting a chat.
# This computer (Ollama, LM Studio, llama.cpp). Leave the model empty to use the first one the server lists.
MUCARO_AI_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
MUCARO_AI_LOCAL_MODEL=
# Another machine or a hosted endpoint. Used only by chats that allow sending content to it.
MUCARO_AI_REMOTE_MODEL_URL=
MUCARO_AI_REMOTE_MODEL=
MUCARO_AI_REMOTE_MODEL_API_KEY=
MUCARO_AI_DEPLOYMENT_PROFILE=local
MUCARO_AI_DISTRIBUTION_CHANNEL=local
MUCARO_AI_DATA_DIR=
MUCARO_AI_ALLOW_PUBLIC_BIND=0
MUCARO_AI_OPERATOR_TOKEN=
# 1 lets a phone on the same Wi-Fi or VPN use Mucaro; it needs an access token. See docs/PHONE_ACCESS.md.
MUCARO_AI_PHONE_ACCESS=0
