# Pinned private runtimes for the double-click setup (Mucaro AI.command / Mucaro AI.cmd).
# Read by scripts/one_click.sh (bash `source`), scripts/one_click_windows.ps1 and scripts/one_click.py.
# Plain KEY=VALUE lines only: no quotes, no spaces, no shell expansion.
# Hashes come from the official release checksum files:
#   https://github.com/astral-sh/uv/releases/download/<UV_VERSION>/uv-<target>.<ext>.sha256
#   https://nodejs.org/dist/v<NODE_VERSION>/SHASUMS256.txt

UV_VERSION=0.12.19
UV_SHA256_aarch64_apple_darwin=a9a8df1eedeb192f2e47e40e2faabfb387db4b850209118786d42f89dde3e0ba
UV_SHA256_x86_64_apple_darwin=cb5fa57bafe68fc0fb94b17f06bee0b0b9a7feb94ccbd110445afa0696e39273
UV_SHA256_x86_64_unknown_linux_gnu=23bf5552d220e0842b65c862097b2ebaeba0064b74eda5e565e77fd25969d8c8
UV_SHA256_x86_64_pc_windows_msvc=6dbb02d79e419522f1c500f0adb1cddcff0cda7d59b0d66ea7f5e3b4a1b2f5f0

NODE_VERSION=22.23.3
NODE_SHA256_darwin_arm64=23b25245dcfb9af7262f8ff142e9e2e0af025368117329e7a7458a51e5922f53
NODE_SHA256_darwin_x64=8a677b0219178efd6eb0e475457c4afb452b521a92f6e67845a73bd85727f2a8
NODE_SHA256_linux_x64=1084aa36196bba4c3a5e69a1ee388a6e4ff729dad09445fbcd434b28fe3c24af
NODE_SHA256_win_x64=2b0ff57b049cda1bbcea2240eec20467018713c1efe1f7360c2681859b90ed71

# CPython minor version installed through the pinned uv (uv 0.12.19 resolves 3.12 to 3.12.14).
PYTHON_VERSION=3.12
# Lock cutoff: scripts/lock_python_deps.py ignores Python packages published after this instant when it
# regenerates packaging/one_click/*.lock, so the same pins always give the same locks.
PY_EXCLUDE_NEWER=2026-09-25T00:00:00Z
# Targeted security refresh; other dependencies retain the original cutoff.
PY_SECURITY_EXCLUDE_NEWER=2026-10-22T00:00:00Z
# Bump when one_click.py changes what a completed setup means; forces every step to rerun once.
SETUP_SCHEMA=1
