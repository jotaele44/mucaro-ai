// Resources for Start Mucaro AI.exe: icon, manifest (asInvoker, Windows 10+), version information.
// Paths are relative to this file's folder (scripts/build_launchers.py compiles from here).

1 ICON "../../icons/mucaro.ico"
1 24 "mucaro_launcher.manifest"

1 VERSIONINFO
FILEVERSION 0,1,23,0
PRODUCTVERSION 0,1,23,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Mucaro AI"
      VALUE "FileDescription", "Start Mucaro AI"
      VALUE "FileVersion", "0.1.23"
      VALUE "InternalName", "mucaro_launcher"
      VALUE "OriginalFilename", "Start Mucaro AI.exe"
      VALUE "ProductName", "Mucaro AI"
      VALUE "ProductVersion", "0.1.23"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
