{
  "schema_version": "mucaro-runtime-independence/1.0",
  "baseline_head": "f258b8747f68117394aebd357bc6e6fbf47613df",
  "goal": "ZERO_MANDATORY_EXTERNAL_RUNTIME_WORK_EXCEPT_EXPLICIT_NETWORK_OPERATIONS",
  "runtime_contract": {
    "default_network_state": "DENY_UNLESS_CAPABILITY_EXPLICITLY_REQUIRES_NETWORK",
    "local_data_default": true,
    "host_package_manager_required": false,
    "host_python_required": false,
    "host_node_required": false,
    "host_git_required_for_core_runtime": false,
    "network_exceptions": [
      "remote model APIs explicitly selected by the operator",
      "web.fetch and web.fetch_session",
      "web.search",
      "web.render for public remote pages",
      "optional update/download operations explicitly initiated by the operator"
    ],
    "packaged_host_path_fallback_allowed": false,
    "source_developer_host_path_fallback_allowed": true
  },
  "dependency_classes": [
    {
      "id": "core_python_runtime",
      "current_state": "PACKAGE_DEPENDENT",
      "target": "BUNDLED_PER_PLATFORM",
      "runtime_external_work_allowed": false
    },
    {
      "id": "frontend_node_toolchain",
      "current_state": "SOURCE_SETUP_REQUIRES_NODE",
      "target": "BUILD_TIME_ONLY",
      "runtime_external_work_allowed": false
    },
    {
      "id": "runtime_source_identity_git",
      "current_state": "REMOVED_IN_BRANCH",
      "target": "READ_LOCAL_VCS_METADATA_OR_BOUND_BUILD_IDENTITY",
      "runtime_external_work_allowed": false
    },
    {
      "id": "coding_git",
      "current_state": "BUNDLED_ONLY_RESOLVER_IN_PACKAGED_RUNTIME_BINARY_NOT_YET_BUNDLED",
      "target": "BUNDLE_OR_REPLACE_PER_PLATFORM",
      "runtime_external_work_allowed": false
    },
    {
      "id": "ocr_tesseract_poppler",
      "current_state": "BUNDLED_ONLY_RESOLVER_IN_PACKAGED_RUNTIME_BINARIES_NOT_YET_BUNDLED",
      "target": "BUNDLE_OPTIONAL_COMPONENTS_WHERE_LICENSE_AND_PLATFORM_ALLOW",
      "runtime_external_work_allowed": false
    },
    {
      "id": "rendered_browser",
      "current_state": "PLAYWRIGHT_AND_BROWSER_RUNTIME_OPTIONAL",
      "target": "BUNDLE_OPTIONAL_RENDER_ENGINE_ON_SUPPORTED_PLATFORMS",
      "runtime_external_work_allowed": false
    },
    {
      "id": "local_model",
      "current_state": "EXTERNAL_LOOPBACK_SERVER_OPTIONAL",
      "target": "OPTIONAL_BUNDLED_MODEL_ENGINE_OR_USER_SELECTED_LOOPBACK_ENGINE",
      "runtime_external_work_allowed": true
    },
    {
      "id": "remote_model_api",
      "current_state": "OPTIONAL_AND_EXPLICIT",
      "target": "KEEP_BEHIND_NETWORK_PERMISSION_GATE",
      "runtime_external_work_allowed": true
    },
    {
      "id": "github_ci_release_governance",
      "current_state": "DEVELOPMENT_AND_RELEASE_ONLY",
      "target": "NEVER_REQUIRED_FOR_INSTALLED_APP_RUNTIME",
      "runtime_external_work_allowed": false
    },
    {
      "id": "container_engine",
      "current_state": "HOST_FALLBACK_DISABLED_IN_PACKAGED_RUNTIME_PLATFORM_ADAPTER_OPEN",
      "target": "REPLACE_WITH_PLATFORM_APPROPRIATE_SANDBOX_OR_BUNDLE_SUPPORTED_ENGINE",
      "runtime_external_work_allowed": false
    }
  ],
  "distribution_states": {
    "source_one_click": {
      "first_run_offline": false,
      "reason": "downloads private runtimes and dependencies before caching them"
    },
    "packaged_desktop": {
      "first_run_offline_target": true,
      "status": "PLATFORM_SPECIFIC_CERTIFICATION_REQUIRED"
    },
    "mobile": {
      "first_run_offline_target": true,
      "status": "ADAPTER_AND_PLATFORM_CERTIFICATION_REQUIRED"
    }
  },
  "certification_rule": "No independence claim passes until a clean device can install the prepared package, launch with the network disabled, exercise every declared offline capability, persist local state, and show zero unexplained external connections or missing mandatory host tools.",
  "non_claims": [
    "This contract does not claim every capability is already bundled.",
    "This contract does not claim feature parity across desktop and mobile.",
    "This contract does not classify explicitly authorized API or fetch traffic as an independence defect.",
    "Bundled-only resolution does not mean Git, OCR engines, or a container engine are already present in every release artifact."
  ]
}
