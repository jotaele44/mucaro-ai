{
  "schema_version": "mucaro-matrix011-tool-governance-benchmark/1.0",
  "benchmark_id": "MATRIX-011-v1",
  "requirement": "MATRIX-011 action-class benchmark (allowed, denied, approval-required, cancelled, tool error, timeout, retry, restart, duplicate invocation) plus the TGT-025 permission taxonomy (filesystem, network, models, tools and other side-effecting capabilities, distribution) and the INV-006 / TGT-014 authority rules (planning never authorizes, no undeclared escalation, approval bound to the action executed, tamper-evident audit, memory and leases cannot widen authority). Evidence for DAG N05 and flagpole V06.",
  "required_categories": [
    "allowed",
    "denied",
    "approval_required",
    "cancelled",
    "tool_error",
    "timeout",
    "retry",
    "restart",
    "duplicate_invocation",
    "filesystem",
    "network",
    "model",
    "side_effecting_capability",
    "distribution",
    "unknown_input",
    "planning_authority",
    "escalation",
    "argument_binding",
    "audit_integrity",
    "memory_authority",
    "lease"
  ],
  "cases": [
